
# Playwright

# ==========================================
# AgenticQA - Node.js
# ==========================================
node_modules/

# ==========================================
# Environment variables and secrets
# ==========================================
.env
.env.*
!.env.example

# Authentication states and credentials
**/storageState.json
**/auth-state.json
**/playwright/.auth/

# Private keys
*.pem
*.key
*.p12
*.pfx

# ==========================================
# Playwright generated reports
# ==========================================
/playwright-report/
/blob-report/
/playwright/.cache/

# ==========================================
# Playwright MCP
# ==========================================
/.playwright-mcp/

# ==========================================
# VS Code - ignore only local settings
# ==========================================
/.vscode/*.local.json

# ==========================================
# Test results
# Ignore everything directly under test-results
# except explicitly allowed files and folders
# ==========================================
/test-results/*

# Preserve the SCRUM-101 test report
!/test-results/SCRUM-101-checkout-test-report.md

# Allow the evidence directory
!/test-results/evidence/

/test-results/evidence/*

# Preserve PNG evidence directly inside evidence
!/test-results/evidence/*.png

# Ignore generated artifacts folders
/test-results/.playwright-artifacts-*/
/test-results/playwright-artifacts/

# ==========================================
# Operating system
# ==========================================
.DS_Store
Thumbs.db
desktop.ini